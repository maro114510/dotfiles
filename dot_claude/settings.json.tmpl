{{- /* Overlay only the keys every machine must share and Claude Code never writes; everything else stays as each machine has it. */ -}}
{{- $managed := fromJson `
{
  "cleanupPeriodDays": 9999,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Edit(.env*)",
      "Read(secrets/**)",
      "Edit(**/secrets/**)",
      "Read(config/credentials.json)",
      "Read(**/credentials/**/*)",
      "Read(~/.ssh/**/*)",
      "Read(~/.aws/**/*)",
      "Read(id_rsa)",
      "Read(id_ed25519)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*token*.json)",
      "Read(**/*token*.yml)",
      "Read(**/*token*.yaml)",
      "Read(**/*token*.txt)",
      "Read(**/*token*.env)",
      "Read(**/*.token)",
      "Bash(sudo:*)",
      "Bash(rm:*)",
      "Bash(rm -rf:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(nc:*)",
      "Bash(npm uninstall:*)",
      "Bash(npm remove:*)",
      "Bash(psql:*)",
      "Bash(mysql:*)",
      "Bash(mongod:*)"
    ]
  }
}
` -}}
{{- $path := joinPath .chezmoi.homeDir ".claude/settings.json" -}}
{{- $config := dict -}}
{{- $original := "" -}}
{{- if stat $path -}}
  {{- $original = include $path -}}
  {{- $config = fromJson $original -}}
{{- end -}}
{{- /* Keep deny rules a machine added itself: mergeOverwrite would replace the whole list. */ -}}
{{- $liveDeny := list -}}
{{- with (get $config "permissions") -}}
  {{- with (get . "deny") -}}{{- $liveDeny = . -}}{{- end -}}
{{- end -}}
{{- $config = mergeOverwrite $config $managed -}}
{{- /* Retired shared rules: Write() is never matched, and the bare token rule also blocked source files such as tokenizer.go. */ -}}
{{- $deny := without (uniq (concat $managed.permissions.deny $liveDeny)) "Write(.env*)" "Write(**/secrets/**)" "Read(**/*token*)" -}}
{{- $_ := set (get $config "permissions") "deny" $deny -}}
{{- /* permissions.read is not a Claude Code setting; the deny list above replaces it. */ -}}
{{- $_ := unset (get $config "permissions") "read" -}}
{{- if and $original (deepEqual (fromJson $original) $config) -}}
{{ $original -}}
{{- else -}}
{{ toPrettyJson $config -}}
{{- end -}}
