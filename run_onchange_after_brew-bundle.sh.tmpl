#!/bin/bash
# Invoked automatically by `chezmoi apply` via the run_onchange_after_ filename prefix.
# Re-runs only when this script's rendered content changes. The `.Brewfile` hash
# below changes whenever dot_Brewfile changes, so a Brewfile edit re-runs brew bundle.

set -euo pipefail

BREWFILE="${HOME}/.Brewfile"

# .Brewfile hash: {{ include "dot_Brewfile" | sha256sum }}

if ! command -v brew &>/dev/null; then
  echo "Homebrew not found — skipping brew bundle." >&2
  exit 0
fi

if [ ! -f "${BREWFILE}" ]; then
  echo "No Brewfile found at $BREWFILE — skipping." >&2
  exit 0
fi

echo "Running brew bundle..."
brew bundle --file="${BREWFILE}"
echo "brew bundle complete."
