#!/bin/bash

# Rejects any push that updates main or master, whatever the remote name or URL.
#
# git passes the remote name as $1 and its URL as $2, which say nothing about
# the target branch. Each ref being pushed arrives on stdin as one line:
#   <local ref> <local sha> <remote ref> <remote sha>

set -euo pipefail

PROTECTED_BRANCHES="main master"

rejected=0

while read -r _ _ remote_ref _; do
    case "${remote_ref}" in
        refs/heads/*) ;;
        *) continue ;;
    esac

    pushed_branch=${remote_ref#refs/heads/}
    for blocked in ${PROTECTED_BRANCHES}; do
        if [ "${pushed_branch}" = "${blocked}" ]; then
            echo "!!  Error: Not permitted to push ${remote_ref} !!" >&2
            rejected=1
        fi
    done
done

exit "${rejected}"
