{{- /* chezmoi:modify-template */ -}}
{{- /* DSH writes this manifest when a plugin is installed from the UI, so only the shared dependencies and bundles are enforced here and everything else stays as the machine has it. */ -}}
{{- /* The dependency versions below are the last set tested against the runtime. The dsh wrapper tracks the newest published release, so update these only after testing a new runtime. */ -}}
{{- $dependencies := fromJson `
{
  "@wxg-prc-cpg/browser-skill-dsh-plugin": "0.5.0",
  "dsh-context": "0.84.1",
  "dsh-mermaid": "^0.4.5",
  "dsh-ops": "^0.5.4",
  "dsh-plugin-subscriptions": "^0.9.13",
  "dshmarket": "^1.73.19"
}
` -}}
{{- /* The order is the precedence order of the layers, so the managed bundles keep this order and local additions follow them. */ -}}
{{- $bundles := list
  "@deepseek-ai/dsh-base"
  "@deepseek-ai/dsh-web-app"
  "@deepseek-ai/dsh-experimental-agent-team-profile"
  "@deepseek-ai/dsh-experimental-auto-review"
  "@deepseek-ai/dsh-experimental-inspector-profile"
  "dsh-plugin-subscriptions"
  "@deepseek-ai/dsh-experimental-forge-bundle"
  "@deepseek-ai/dsh-experimental-plugin-market-bundle"
  "dsh-mermaid"
  "@deepseek-ai/dsh-experimental-session-titles-bundle"
  "dshmarket"
  "dsh-context"
  "@wxg-prc-cpg/browser-skill-dsh-plugin"
  "dsh-ops"
-}}
{{- $original := .chezmoi.stdin | trim -}}
{{- $config := dict "name" "dsh-profile-web" "private" true -}}
{{- if $original -}}
  {{- $config = fromJson $original -}}
{{- end -}}
{{- /* The subagent plugins are not wanted, so an earlier install of them is dropped too. */ -}}
{{- $removed := list "@deepseek-ai/dsh-subagent-codex" "@deepseek-ai/dsh-subagent-claude-code" -}}
{{- $existing := omit (get $config "dependencies" | default dict) "@deepseek-ai/dsh-subagent-codex" "@deepseek-ai/dsh-subagent-claude-code" -}}
{{- $config = set $config "dependencies" (mergeOverwrite $existing $dependencies) -}}
{{- $dsh := get $config "dsh" | default dict -}}
{{- $profile := get $dsh "profile" | default dict -}}
{{- $merged := $bundles -}}
{{- range (get $profile "bundles" | default list) -}}
  {{- if and (not (has . $bundles)) (not (has . $removed)) -}}
    {{- $merged = append $merged . -}}
  {{- end -}}
{{- end -}}
{{- $profile = set $profile "bundles" $merged -}}
{{- $config = set $config "dsh" (set $dsh "profile" $profile) -}}
{{- if and $original (deepEqual (fromJson $original) $config) -}}
{{ .chezmoi.stdin -}}
{{- else -}}
{{ toPrettyJson $config }}
{{ end -}}
