#!/bin/bash
# chezmoi run_onchange_after_ script: install srt into the OpenCode sandbox plugin.
#
# OpenCode installs nothing for a local plugin, and the plugin refuses every
# shell command until srt can be loaded. The hashes below change whenever the
# plugin's dependencies change, so editing them re-runs this script.
#
# Bun is a mise-managed tool, so on a fresh Mac this script can run before
# `mise install` has provided it. It then exits non-zero, and chezmoi keeps it
# pending so the next `chezmoi apply` retries it.
#
# package.json hash: {{ include "dot_config/opencode/plugins/srt-sandbox/package.json" | sha256sum }}
# bun.lock hash: {{ include "dot_config/opencode/plugins/srt-sandbox/bun.lock" | sha256sum }}

set -euo pipefail

PLUGIN_DIR="${HOME}/.config/opencode/plugins/srt-sandbox"

if ! command -v bun &>/dev/null; then
  echo "Error: Bun is required to install srt for the OpenCode sandbox plugin, but it is not on PATH." >&2
  echo "Install the mise-managed tool and re-run 'chezmoi apply':" >&2
  echo "  mise install bun" >&2
  exit 1
fi

cd "${PLUGIN_DIR}"

# Install exactly the versions bun.lock records; fail instead of rewriting it.
bun install --frozen-lockfile --production
