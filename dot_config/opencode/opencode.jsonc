{
	"$schema": "https://opencode.ai/config.json",
	"autoupdate": false,
	"agent": {
		"explore": {
			"model": "{env:OPENCODE_CHEAP_MODEL}",
		},
	},
	"plugin": [
		"op-anthropic-auth@latest",
	],
	// Rules are evaluated last-match-wins, and are appended after the built-in
	// agent rules. Do not add a top-level "*" or a "*" key under read/edit/
	// external_directory: it would override plan/explore restrictions and the
	// built-in skill/tmp whitelist. Keep key order: "*" -> allow -> ask -> deny.
	"permission": {
		// Patterns are relative to the worktree ("../../.ssh/id_rsa"), so list
		// both the root form and the "*/" form.
		"read": {
			".env*": "deny",
			"*/.env*": "deny",
			"*.pem": "deny",
			"*.key": "deny",
			"*token*": "deny",
			"*id_rsa": "deny",
			"*id_ed25519": "deny",
			"secrets/*": "deny",
			"*/secrets/*": "deny",
			"credentials/*": "deny",
			"*/credentials/*": "deny",
			"config/credentials.json": "deny",
			".ssh/*": "deny",
			"*/.ssh/*": "deny",
			".aws/*": "deny",
			"*/.aws/*": "deny",
		},
		"edit": {
			".env*": "deny",
			"*/.env*": "deny",
			"secrets/*": "deny",
			"*/secrets/*": "deny",
		},
		// Absolute patterns match here. Also covers read/edit/grep/glob and
		// bash cd/cat/cp/mv/rm/mkdir/touch/chmod/chown path arguments.
		"external_directory": {
			"~/*": "allow",
			"~/.ssh/*": "deny",
			"~/.aws/*": "deny",
		},
		// V1 accepts only a single action here (no per-URL rules).
		"webfetch": "allow",
		// Best effort only: matching is on each command's source text, so
		// wrappers, `{ ...; } > f` and `VAR=x cmd` are not reliably caught.
		"bash": {
			"*": "allow",

			// shell wrappers: could smuggle denied commands past the rules below
			"bash *": "ask",
			"sh *": "ask",
			"zsh *": "ask",
			"eval *": "ask",
			"xargs *": "ask",

			// git: irreversible only
			"git push -f*": "ask",
			"git push * -f*": "ask",
			"git push *--force*": "ask",
			"git restore *": "ask",
			"git clean *": "ask",
			"git stash drop *": "ask",
			"git stash clear *": "ask",
			"git branch *-D*": "ask",
			"git worktree remove -f*": "ask",
			"git worktree remove * -f*": "ask",
			"git worktree remove *--force*": "ask",

			// gh: irreversible or high impact only
			"gh pr merge *": "ask",
			"gh issue delete *": "ask",
			"gh release *": "ask",
			"gh repo delete *": "ask",
			"gh workflow run *": "ask",
			"gh run rerun *": "ask",

			// installs / system state
			"npm install *": "ask",
			"npm i *": "ask",
			"pnpm add *": "ask",
			"yarn add *": "ask",
			"pip install *": "ask",
			"brew *": "ask",
			"chezmoi apply *": "ask",
			"kill *": "ask",
			"pkill *": "ask",
			"killall *": "ask",
			"terraform apply *": "ask",
			"terraform destroy *": "ask",

			// narrow specific forms back to ask
			"find *-exec*": "ask",
			"find *-ok*": "ask",
			"find *-delete*": "ask",
			"find *-fprint*": "ask",
			"find *-fls*": "ask",
			"sed *-i*": "ask",
			"sed *-?i*": "ask",
			"git pull *-r*": "ask",
			"git checkout *--*": "ask",
			"git checkout *-f*": "ask",
			"git checkout *.": "ask",
			"gh api *-X*": "ask",
			"gh api *--method*": "ask",
			"gh api *-f*": "ask",
			"gh api *-F*": "ask",
			"gh api *--input*": "ask",
			"* > *": "ask",
			"* >> *": "ask",
			"* >| *": "ask",
			"* &> *": "ask",
			"* 2> *": "ask",

			// deny
			"sudo *": "deny",
			"rm *": "deny",
			"git reset *": "deny",
			"git rebase *": "deny",
			"curl *": "deny",
			"wget *": "deny",
			"nc *": "deny",
			"npm uninstall *": "deny",
			"npm remove *": "deny",
			"psql *": "deny",
			"mysql *": "deny",
			"mongod *": "deny",
			"*.env*": "deny",
			"*.pem*": "deny",
			"*secrets/*": "deny",
			"*credentials*": "deny",
			"*/.ssh*": "deny",
			"*/.aws*": "deny",
			"*id_rsa*": "deny",
			"*id_ed25519*": "deny",
		},
	},
}
