{
	"$schema": "https://opencode.ai/config.json",
	"autoupdate": false,
	"agent": {
		"explore": {
			"model": "{env:OPENCODE_CHEAP_MODEL}",
		},
	},
	"plugin": [
		"op-anthropic-auth@latest",
	],
	// Rules are evaluated last-match-wins, and are appended after the built-in
	// agent rules. Do not add a top-level "*" or a "*" key under read/edit/
	// external_directory: it would override plan/explore restrictions and the
	// built-in skill/tmp whitelist. Keep key order: "*" -> allow -> ask ->
	// deny -> narrow exceptions to a deny (-> denies that must always win).
	"permission": {
		// Patterns are relative to the worktree ("../../.ssh/id_rsa"), so list
		// both the root form and the "*/" form.
		"read": {
			".env*": "deny",
			"*/.env*": "deny",
			"*.pem": "deny",
			"*.key": "deny",
			"*id_rsa": "deny",
			"*id_ed25519": "deny",
			"*credentials.json": "deny",
			"*.git-credentials": "deny",
			"*credentials.db": "deny",
			"*access_tokens.db": "deny",
			".ssh/*": "deny",
			"*/.ssh/*": "deny",
			".aws/*": "deny",
			"*/.aws/*": "deny",
			// committed templates, not secrets
			"*.env.example": "allow",
			"*.env.sample": "allow",
			"*.env.template": "allow",
		},
		"edit": {
			".env*": "deny",
			"*/.env*": "deny",
		},
		// Absolute patterns match here. Also covers read/edit/grep/glob and
		// bash cd/cat/cp/mv/rm/mkdir/touch/chmod/chown path arguments.
		"external_directory": {
			"~/*": "allow",
			"~/.ssh/*": "deny",
			"~/.aws/*": "deny",
		},
		// V1 accepts only a single action here (no per-URL rules).
		"webfetch": "allow",
		// Allow by default; ask only for what cannot be undone, deny only what
		// breaks the machine or leaks secrets. Best effort only: matching is on
		// each command's source text (redirects included), so `bash -c "..."`
		// bodies, `python -c`, scripts, `VAR=x cmd`, `xargs`/`env`/`nohup`
		// prefixes and `git -C x ...` are not reliably caught. "*" also spans
		// spaces, so anchor flags with a leading space to avoid hitting paths
		// or branch names. Any rule re-allowing a deny also overrides every
		// earlier rule, so keep such exceptions narrow and the machine-breaking
		// denies last.
		"bash": {
			"*": "allow",

			// wrappers that run a string: its commands are not checked
			"bash -c *": "ask",
			"bash -?c *": "ask",
			"bash -??c *": "ask",
			"bash * -c *": "ask",
			"sh -c *": "ask",
			"sh -?c *": "ask",
			"sh -??c *": "ask",
			"sh * -c *": "ask",
			"zsh -c *": "ask",
			"zsh -?c *": "ask",
			"zsh -??c *": "ask",
			"zsh * -c *": "ask",
			"eval *": "ask",

			// recursive delete
			"rm -r*": "ask",
			"rm -?r*": "ask",
			"rm -R*": "ask",
			"rm -?R*": "ask",
			"rm * -r*": "ask",
			"rm * -?r*": "ask",
			"rm * -R*": "ask",
			"rm *--recursive*": "ask",

			// git: loses uncommitted work
			"git restore *": "ask",
			"git clean *": "ask",
			"git stash drop *": "ask",
			"git stash clear *": "ask",
			"git checkout *--*": "ask",
			"git checkout -f*": "ask",
			"git checkout * -f*": "ask",
			"git checkout *.": "ask",
			"git switch -f*": "ask",
			"git switch * -f*": "ask",
			"git switch *--force*": "ask",
			"git switch *--discard-changes*": "ask",
			"git *reset *--hard*": "ask",
			"git worktree remove -f*": "ask",
			"git worktree remove * -f*": "ask",
			"git worktree remove *--force*": "ask",
			// git: removes what reflog could restore
			"git branch -D*": "ask",
			"git branch * -D*": "ask",
			"git reflog expire*": "ask",
			"git reflog delete*": "ask",
			"git gc *--prune*": "ask",
			"git prune*": "ask",
			"git update-ref -d*": "ask",
			"git update-ref * -d*": "ask",
			"git filter-branch*": "ask",
			"git filter-repo*": "ask",
			// git: rewrites or deletes remote refs
			"git push -f*": "ask",
			"git push * -f*": "ask",
			"git push *--force*": "ask",
			"git push * +*": "ask",
			"git push -d*": "ask",
			"git push * -d*": "ask",
			"git push *--delete*": "ask",
			"git push * :*": "ask",
			"git push *--mirror*": "ask",
			"git push *--prune*": "ask",

			// gh: deletes, secret overwrites, visibility changes
			"gh repo delete*": "ask",
			"gh repo deploy-key delete*": "ask",
			"gh repo edit *--visibility*": "ask",
			"gh issue delete*": "ask",
			"gh release delete*": "ask",
			"gh run delete*": "ask",
			"gh cache delete*": "ask",
			"gh label delete*": "ask",
			"gh gist delete*": "ask",
			"gh project delete*": "ask",
			"gh project item-delete*": "ask",
			"gh project field-delete*": "ask",
			"gh codespace delete*": "ask",
			"gh ssh-key delete*": "ask",
			"gh gpg-key delete*": "ask",
			"gh secret set*": "ask",
			"gh secret delete*": "ask",
			"gh secret remove*": "ask",
			"gh variable delete*": "ask",
			"gh variable remove*": "ask",
			"gh api *-X*DELETE*": "ask",
			"gh api *-X*delete*": "ask",
			"gh api *--method*DELETE*": "ask",
			"gh api *--method*delete*": "ask",
			"gh api *graphql*mutation*delete*": "ask",

			// new packages (supply chain). Restoring from a lockfile is allowed.
			"npm install ?*": "ask",
			"npm i ?*": "ask",
			"npm add ?*": "ask",
			"npm exec *": "ask",
			"npx *": "ask",
			"pnpm add *": "ask",
			"pnpm * add *": "ask",
			"pnpm install ?*": "ask",
			"pnpm i ?*": "ask",
			"pnpm dlx *": "ask",
			"yarn add *": "ask",
			"yarn * add *": "ask",
			"yarn global *": "ask",
			"yarn dlx *": "ask",
			"bun add *": "ask",
			"bun install ?*": "ask",
			"bun i ?*": "ask",
			"bun x *": "ask",
			"bunx *": "ask",
			"pip* install *": "ask",
			"python* -m pip install *": "ask",
			"pipx run *": "ask",
			"uv add *": "ask",
			"uv pip install *": "ask",
			"uv tool install *": "ask",
			"uv tool run *": "ask",
			"uvx *": "ask",
			"brew install *": "ask",
			"brew uninstall *": "ask",
			"brew remove *": "ask",
			"brew rm *": "ask",
			"brew upgrade *": "ask",
			"brew reinstall *": "ask",
			"brew tap *": "ask",
			"brew untap *": "ask",
			"go install *": "ask",
			"go get *": "ask",
			"cargo install *": "ask",
			"cargo add *": "ask",
			"gem install *": "ask",
			// lockfile / requirements file: restore, not add
			"pnpm install --frozen-lockfile": "allow",
			"pnpm i --frozen-lockfile": "allow",
			"bun install --frozen-lockfile": "allow",
			"bun i --frozen-lockfile": "allow",
			"pip* install -r *.txt": "allow",
			"python* -m pip install -r *.txt": "allow",
			"uv pip install -r *.txt": "allow",

			// cloud / db: destructive or tokens into the context
			"terraform apply *": "ask",
			"terraform destroy *": "ask",
			"terraform * apply*": "ask",
			"terraform * destroy*": "ask",
			"kubectl delete *": "ask",
			"kubectl * delete *": "ask",
			"gcloud * delete *": "ask",
			"gcloud storage rm *": "ask",
			"gsutil rm *": "ask",
			"gsutil * rm *": "ask",
			"bq rm *": "ask",
			"bq * rm *": "ask",
			"gcloud auth print-access-token*": "ask",
			"gcloud auth print-identity-token*": "ask",
			"gcloud auth application-default print-access-token*": "ask",
			"gcloud spanner databases execute-sql*": "ask",
			"psql *": "ask",
			"mysql *": "ask",
			"mongod *": "ask",

			// system
			"dd *": "ask",
			"shutdown *": "ask",
			"reboot *": "ask",
			"halt *": "ask",

			// deny: secret files named as a path argument (bare, quoted, `<`,
			// curl `@`). A template next to a secret is indistinguishable here,
			// so .env.example is readable via the read tool, not via bash.
			"* .env *": "deny",
			"*/.env *": "deny",
			"*\".env\"*": "deny",
			"*'.env'*": "deny",
			"*/.env\"*": "deny",
			"*/.env'*": "deny",
			"*<.env *": "deny",
			"*@.env *": "deny",
			"* .env.*": "deny",
			"*/.env.*": "deny",
			"*\".env.*": "deny",
			"*'.env.*": "deny",
			"*<.env.*": "deny",
			"*@.env.*": "deny",
			"*.envrc*": "deny",
			"*.pem *": "deny",
			"*credentials.json*": "deny",
			"*.git-credentials*": "deny",
			"*credentials.db*": "deny",
			"*access_tokens.db*": "deny",
			"*/.ssh*": "deny",
			"*/.aws*": "deny",
			"*id_rsa*": "deny",
			"*id_ed25519*": "deny",
			// bootstrap .env from a committed template (cp with a non-dir target
			// takes exactly one source)
			"cp *.env.example *.env": "allow",
			"cp *.env.sample *.env": "allow",
			"cp *.env.template *.env": "allow",

			// deny: breaks the machine. Last, so no exception above re-allows it.
			"sudo *": "deny",
			"rm * / *": "deny",
			"rm * /? *": "deny",
			"rm * ~ *": "deny",
			"rm * ~/ *": "deny",
			"rm * ~/? *": "deny",
			"rm * $HOME *": "deny",
			"rm * $HOME/ *": "deny",
			"rm * $HOME/? *": "deny",
			"rm * \"$HOME\" *": "deny",
			"rm * \"$HOME/\" *": "deny",
			"mkfs*": "deny",
			"diskutil erase*": "deny",
			"diskutil zeroDisk*": "deny",
			"diskutil secureErase*": "deny",
			"diskutil partitionDisk*": "deny",
			"diskutil apfs delete*": "deny",
			"diskutil apfs erase*": "deny",
		},
	},
}
