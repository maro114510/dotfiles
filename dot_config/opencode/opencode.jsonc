{
	"$schema": "https://opencode.ai/config.json",
	"autoupdate": false,
	"agent": {
		"explore": {
			"model": "{env:OPENCODE_CHEAP_MODEL}",
		},
	},
	"plugin": [
		"op-anthropic-auth@latest",
	],
	// Rules are evaluated last-match-wins, and are appended after the built-in
	// agent rules. Do not add a top-level "*" or a "*" key under read/edit/
	// external_directory: it would override plan/explore restrictions and the
	// built-in skill/tmp whitelist. Keep key order: "*" -> allow -> ask -> deny.
	"permission": {
		// Patterns are relative to the worktree ("../../.ssh/id_rsa"), so list
		// both the root form and the "*/" form.
		"read": {
			".env*": "deny",
			"*/.env*": "deny",
			"*.pem": "deny",
			"*.key": "deny",
			"*token*": "deny",
			"*id_rsa": "deny",
			"*id_ed25519": "deny",
			"secrets/*": "deny",
			"*/secrets/*": "deny",
			"credentials/*": "deny",
			"*/credentials/*": "deny",
			"config/credentials.json": "deny",
			".ssh/*": "deny",
			"*/.ssh/*": "deny",
			".aws/*": "deny",
			"*/.aws/*": "deny",
		},
		"edit": {
			".env*": "deny",
			"*/.env*": "deny",
			"secrets/*": "deny",
			"*/secrets/*": "deny",
		},
		// Absolute patterns match here. Also covers read/edit/grep/glob and
		// bash cd/cat/cp/mv/rm/mkdir/touch/chmod/chown path arguments.
		"external_directory": {
			"~/.ssh/*": "deny",
			"~/.aws/*": "deny",
		},
		// V1 accepts only a single action here (no per-URL rules).
		"webfetch": "ask",
		// Best effort only: matching is on each command's source text, so
		// wrappers, `{ ...; } > f` and `VAR=x cmd` are not reliably caught.
		"bash": {
			"*": "ask",

			// read-only / inspection
			"ls *": "allow",
			"tree *": "allow",
			"find *": "allow",
			"grep *": "allow",
			"rg *": "allow",
			"cat *": "allow",
			"head *": "allow",
			"tail *": "allow",
			"wc *": "allow",
			"diff *": "allow",
			"jq *": "allow",
			"sed *": "allow",
			"sort *": "allow",
			"uniq *": "allow",
			"cut *": "allow",
			"tr *": "allow",
			"file *": "allow",
			"stat *": "allow",
			"du *": "allow",
			"df *": "allow",
			"basename *": "allow",
			"dirname *": "allow",
			"realpath *": "allow",
			"readlink *": "allow",
			"which *": "allow",
			"type *": "allow",
			"whoami *": "allow",
			"id *": "allow",
			"pwd *": "allow",
			"uname *": "allow",
			"date *": "allow",
			"echo *": "allow",

			// local mutation
			"mkdir *": "allow",
			"chmod *": "allow",

			// git
			"git status *": "allow",
			"git log *": "allow",
			"git show *": "allow",
			"git rev-parse *": "allow",
			"git fetch *": "allow",
			"git pull *": "allow",
			"git checkout *": "allow",
			"git rm *": "allow",
			"git tag *": "allow",

			// gh
			"gh pr view *": "allow",
			"gh pr diff *": "allow",
			"gh repo view *": "allow",
			"gh run list *": "allow",
			"gh run view *": "allow",
			"gh workflow list *": "allow",
			"gh api *": "allow",

			// go / lint / make
			"go build *": "allow",
			"go test *": "allow",
			"go vet *": "allow",
			"go doc *": "allow",
			"go mod *": "allow",
			"go get *": "allow",
			"go generate *": "allow",
			"go clean *": "allow",
			"go version *": "allow",
			"go tool cover *": "allow",
			"golangci-lint *": "allow",
			"cfn-lint *": "allow",
			"shellcheck *": "allow",
			"make lint *": "allow",
			"make lint-informant-review *": "allow",
			"make test *": "allow",
			"make test-coverage *": "allow",
			"serena structure *": "allow",

			// narrow the allows above back to ask
			"find *-exec*": "ask",
			"find *-ok*": "ask",
			"find *-delete*": "ask",
			"find *-fprint*": "ask",
			"find *-fls*": "ask",
			"sed *-i*": "ask",
			"sed *-?i*": "ask",
			"git pull *-r*": "ask",
			"git checkout *--*": "ask",
			"git checkout *-f*": "ask",
			"git checkout *.": "ask",
			"gh api *-X*": "ask",
			"gh api *--method*": "ask",
			"gh api *-f*": "ask",
			"gh api *-F*": "ask",
			"gh api *--input*": "ask",
			"* > *": "ask",
			"* >> *": "ask",
			"* >| *": "ask",
			"* &> *": "ask",
			"* 2> *": "ask",

			// deny
			"sudo *": "deny",
			"rm *": "deny",
			"git reset *": "deny",
			"git rebase *": "deny",
			"curl *": "deny",
			"wget *": "deny",
			"nc *": "deny",
			"npm uninstall *": "deny",
			"npm remove *": "deny",
			"psql *": "deny",
			"mysql *": "deny",
			"mongod *": "deny",
			"*.env*": "deny",
			"*.pem*": "deny",
			"*secrets/*": "deny",
			"*credentials*": "deny",
			"*/.ssh*": "deny",
			"*/.aws*": "deny",
			"*id_rsa*": "deny",
			"*id_ed25519*": "deny",
		},
	},
}
