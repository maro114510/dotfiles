{
  "$schema": "https://opencode.ai/config.json",
  // The version is managed by mise (see mise.lock); never self-update
  "update": "disable",
  // Snapshots git-scan the whole worktree every step; undo edits with git instead
  "snapshots": false,
  // Default for every agent, including the build agent `opencode run` uses
  "model": "openai/gpt-5.6-luna",
  "experimental": {
    // Todos are off by default in V2
    "todo": true,
  },
  "agents": {
    "explore": {
      "model": "openai/gpt-5.6-luna",
    },
  },
  // Ordered rules, last match wins. They are appended after the built-in
  // defaults and after the built-in agent rules (plan/explore restrictions),
  // so do not add a catch-all { "action": "*", "resource": "*" } rule or an
  // "allow" for "*" under read/edit: it would override those restrictions.
  // Keep the order: external_directory ask -> allow -> ask -> deny -> narrow
  // exceptions to a deny (-> denies that must always win).
  "permissions": [
    // V1 asked before touching paths outside the project; V2 allows them by
    // default. Restore the prompt first, then open only what is listed below.
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    // Paths inside the working directory are relative to it; paths outside
    // are absolute. "*" spans "/", so list both the root form and the "*/"
    // form of anything that must match at any depth.
    { "action": "read", "resource": ".env*", "effect": "deny" },
    { "action": "read", "resource": "*/.env*", "effect": "deny" },
    { "action": "read", "resource": "*.pem", "effect": "deny" },
    { "action": "read", "resource": "*.key", "effect": "deny" },
    { "action": "read", "resource": "*id_rsa", "effect": "deny" },
    { "action": "read", "resource": "*id_ed25519", "effect": "deny" },
    { "action": "read", "resource": "*credentials.json", "effect": "deny" },
    { "action": "read", "resource": "*.git-credentials", "effect": "deny" },
    { "action": "read", "resource": "*credentials.db", "effect": "deny" },
    { "action": "read", "resource": "*access_tokens.db", "effect": "deny" },
    { "action": "read", "resource": ".ssh/*", "effect": "deny" },
    { "action": "read", "resource": "*/.ssh/*", "effect": "deny" },
    { "action": "read", "resource": ".aws/*", "effect": "deny" },
    { "action": "read", "resource": "*/.aws/*", "effect": "deny" },
    // committed templates, not secrets
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "read", "resource": "*.env.sample", "effect": "allow" },
    { "action": "read", "resource": "*.env.template", "effect": "allow" },
    { "action": "edit", "resource": ".env*", "effect": "deny" },
    { "action": "edit", "resource": "*/.env*", "effect": "deny" },
    // Absolute patterns match here; a leading "~" is expanded when the config
    // loads. Covers read/edit/write/patch paths and the working directory or
    // `cd` targets of a shell command. It does NOT cover other path arguments
    // or redirect targets of a shell command (anomalyco/opencode#56288).
    { "action": "external_directory", "resource": "~/*", "effect": "allow" },
    // Scratch space: temp dirs asked ~1,100 times in 5 days of V1 use, nearly
    // always for throwaway work. macOS resolves /tmp and /var to /private/*,
    // and OpenCode's own temp directory lives under /var/folders.
    { "action": "external_directory", "resource": "/tmp/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/private/tmp/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/var/tmp/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/private/var/tmp/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/var/folders/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/private/var/folders/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.ssh/*", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.aws/*", "effect": "deny" },
    // Every URL is allowed (the resource is the URL, so it could be narrowed).
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    // Allow by default; ask only for what cannot be undone, deny only what
    // breaks the machine or leaks secrets. Best effort only: a compound
    // command is split into simple commands and each one is matched on its
    // source text (redirects and `VAR=x` prefixes included), but `bash -c
    // "..."` bodies, `python -c`, scripts, `xargs`/`env`/`nohup` prefixes and
    // `git -C x ...` are not reliably caught, and a command the scanner
    // cannot analyze fails instead of asking. "*" also spans spaces, so
    // anchor flags with a leading space to avoid hitting paths or branch
    // names. A trailing " *" also matches the bare command. Any rule
    // re-allowing a deny also overrides every earlier rule, so keep such
    // exceptions narrow and the machine-breaking denies last.
    { "action": "shell", "resource": "*", "effect": "allow" },

    // wrappers that run a string: its commands are not checked
    { "action": "shell", "resource": "bash -c *", "effect": "ask" },
    { "action": "shell", "resource": "bash -?c *", "effect": "ask" },
    { "action": "shell", "resource": "bash -??c *", "effect": "ask" },
    { "action": "shell", "resource": "bash * -c *", "effect": "ask" },
    { "action": "shell", "resource": "sh -c *", "effect": "ask" },
    { "action": "shell", "resource": "sh -?c *", "effect": "ask" },
    { "action": "shell", "resource": "sh -??c *", "effect": "ask" },
    { "action": "shell", "resource": "sh * -c *", "effect": "ask" },
    { "action": "shell", "resource": "zsh -c *", "effect": "ask" },
    { "action": "shell", "resource": "zsh -?c *", "effect": "ask" },
    { "action": "shell", "resource": "zsh -??c *", "effect": "ask" },
    { "action": "shell", "resource": "zsh * -c *", "effect": "ask" },
    { "action": "shell", "resource": "eval *", "effect": "ask" },

    // recursive delete
    { "action": "shell", "resource": "rm -r*", "effect": "ask" },
    { "action": "shell", "resource": "rm -?r*", "effect": "ask" },
    { "action": "shell", "resource": "rm -R*", "effect": "ask" },
    { "action": "shell", "resource": "rm -?R*", "effect": "ask" },
    { "action": "shell", "resource": "rm * -r*", "effect": "ask" },
    { "action": "shell", "resource": "rm * -?r*", "effect": "ask" },
    { "action": "shell", "resource": "rm * -R*", "effect": "ask" },
    { "action": "shell", "resource": "rm *--recursive*", "effect": "ask" },

    // git: loses uncommitted work
    { "action": "shell", "resource": "git restore *", "effect": "ask" },
    { "action": "shell", "resource": "git clean *", "effect": "ask" },
    { "action": "shell", "resource": "git stash drop *", "effect": "ask" },
    { "action": "shell", "resource": "git stash clear *", "effect": "ask" },
    { "action": "shell", "resource": "git checkout *--*", "effect": "ask" },
    { "action": "shell", "resource": "git checkout -f*", "effect": "ask" },
    { "action": "shell", "resource": "git checkout * -f*", "effect": "ask" },
    { "action": "shell", "resource": "git checkout *.", "effect": "ask" },
    { "action": "shell", "resource": "git switch -f*", "effect": "ask" },
    { "action": "shell", "resource": "git switch * -f*", "effect": "ask" },
    { "action": "shell", "resource": "git switch *--force*", "effect": "ask" },
    { "action": "shell", "resource": "git switch *--discard-changes*", "effect": "ask" },
    { "action": "shell", "resource": "git *reset *--hard*", "effect": "ask" },
    { "action": "shell", "resource": "git worktree remove -f*", "effect": "ask" },
    { "action": "shell", "resource": "git worktree remove * -f*", "effect": "ask" },
    { "action": "shell", "resource": "git worktree remove *--force*", "effect": "ask" },
    // git: removes what reflog could restore
    { "action": "shell", "resource": "git branch -D*", "effect": "ask" },
    { "action": "shell", "resource": "git branch * -D*", "effect": "ask" },
    { "action": "shell", "resource": "git reflog expire*", "effect": "ask" },
    { "action": "shell", "resource": "git reflog delete*", "effect": "ask" },
    { "action": "shell", "resource": "git gc *--prune*", "effect": "ask" },
    { "action": "shell", "resource": "git prune*", "effect": "ask" },
    { "action": "shell", "resource": "git update-ref -d*", "effect": "ask" },
    { "action": "shell", "resource": "git update-ref * -d*", "effect": "ask" },
    { "action": "shell", "resource": "git filter-branch*", "effect": "ask" },
    { "action": "shell", "resource": "git filter-repo*", "effect": "ask" },
    // git: rewrites or deletes remote refs
    { "action": "shell", "resource": "git push -f*", "effect": "ask" },
    { "action": "shell", "resource": "git push * -f*", "effect": "ask" },
    { "action": "shell", "resource": "git push *--force*", "effect": "ask" },
    { "action": "shell", "resource": "git push * +*", "effect": "ask" },
    { "action": "shell", "resource": "git push -d*", "effect": "ask" },
    { "action": "shell", "resource": "git push * -d*", "effect": "ask" },
    { "action": "shell", "resource": "git push *--delete*", "effect": "ask" },
    { "action": "shell", "resource": "git push * :*", "effect": "ask" },
    { "action": "shell", "resource": "git push *--mirror*", "effect": "ask" },
    { "action": "shell", "resource": "git push *--prune*", "effect": "ask" },

    // gh: deletes, secret overwrites, visibility changes
    { "action": "shell", "resource": "gh repo delete*", "effect": "ask" },
    { "action": "shell", "resource": "gh repo deploy-key delete*", "effect": "ask" },
    { "action": "shell", "resource": "gh repo edit *--visibility*", "effect": "ask" },
    { "action": "shell", "resource": "gh issue delete*", "effect": "ask" },
    { "action": "shell", "resource": "gh release delete*", "effect": "ask" },
    { "action": "shell", "resource": "gh run delete*", "effect": "ask" },
    { "action": "shell", "resource": "gh cache delete*", "effect": "ask" },
    { "action": "shell", "resource": "gh label delete*", "effect": "ask" },
    { "action": "shell", "resource": "gh gist delete*", "effect": "ask" },
    { "action": "shell", "resource": "gh project delete*", "effect": "ask" },
    { "action": "shell", "resource": "gh project item-delete*", "effect": "ask" },
    { "action": "shell", "resource": "gh project field-delete*", "effect": "ask" },
    { "action": "shell", "resource": "gh codespace delete*", "effect": "ask" },
    { "action": "shell", "resource": "gh ssh-key delete*", "effect": "ask" },
    { "action": "shell", "resource": "gh gpg-key delete*", "effect": "ask" },
    { "action": "shell", "resource": "gh secret set*", "effect": "ask" },
    { "action": "shell", "resource": "gh secret delete*", "effect": "ask" },
    { "action": "shell", "resource": "gh secret remove*", "effect": "ask" },
    { "action": "shell", "resource": "gh variable delete*", "effect": "ask" },
    { "action": "shell", "resource": "gh variable remove*", "effect": "ask" },
    { "action": "shell", "resource": "gh api *-X*DELETE*", "effect": "ask" },
    { "action": "shell", "resource": "gh api *-X*delete*", "effect": "ask" },
    { "action": "shell", "resource": "gh api *--method*DELETE*", "effect": "ask" },
    { "action": "shell", "resource": "gh api *--method*delete*", "effect": "ask" },
    { "action": "shell", "resource": "gh api *graphql*mutation*delete*", "effect": "ask" },

    // new packages (supply chain). Restoring from a lockfile is allowed.
    { "action": "shell", "resource": "npm install ?*", "effect": "ask" },
    { "action": "shell", "resource": "npm i ?*", "effect": "ask" },
    { "action": "shell", "resource": "npm add ?*", "effect": "ask" },
    { "action": "shell", "resource": "npm exec *", "effect": "ask" },
    { "action": "shell", "resource": "npx *", "effect": "ask" },
    { "action": "shell", "resource": "pnpm add *", "effect": "ask" },
    { "action": "shell", "resource": "pnpm * add *", "effect": "ask" },
    { "action": "shell", "resource": "pnpm install ?*", "effect": "ask" },
    { "action": "shell", "resource": "pnpm i ?*", "effect": "ask" },
    { "action": "shell", "resource": "pnpm dlx *", "effect": "ask" },
    { "action": "shell", "resource": "yarn add *", "effect": "ask" },
    { "action": "shell", "resource": "yarn * add *", "effect": "ask" },
    { "action": "shell", "resource": "yarn global *", "effect": "ask" },
    { "action": "shell", "resource": "yarn dlx *", "effect": "ask" },
    { "action": "shell", "resource": "bun add *", "effect": "ask" },
    { "action": "shell", "resource": "bun install ?*", "effect": "ask" },
    { "action": "shell", "resource": "bun i ?*", "effect": "ask" },
    { "action": "shell", "resource": "bun x *", "effect": "ask" },
    { "action": "shell", "resource": "bunx *", "effect": "ask" },
    { "action": "shell", "resource": "pip* install *", "effect": "ask" },
    { "action": "shell", "resource": "python* -m pip install *", "effect": "ask" },
    { "action": "shell", "resource": "pipx run *", "effect": "ask" },
    { "action": "shell", "resource": "uv add *", "effect": "ask" },
    { "action": "shell", "resource": "uv pip install *", "effect": "ask" },
    { "action": "shell", "resource": "uv tool install *", "effect": "ask" },
    { "action": "shell", "resource": "uv tool run *", "effect": "ask" },
    { "action": "shell", "resource": "uvx *", "effect": "ask" },
    { "action": "shell", "resource": "brew install *", "effect": "ask" },
    { "action": "shell", "resource": "brew uninstall *", "effect": "ask" },
    { "action": "shell", "resource": "brew remove *", "effect": "ask" },
    { "action": "shell", "resource": "brew rm *", "effect": "ask" },
    { "action": "shell", "resource": "brew upgrade *", "effect": "ask" },
    { "action": "shell", "resource": "brew reinstall *", "effect": "ask" },
    { "action": "shell", "resource": "brew tap *", "effect": "ask" },
    { "action": "shell", "resource": "brew untap *", "effect": "ask" },
    { "action": "shell", "resource": "go install *", "effect": "ask" },
    { "action": "shell", "resource": "go get *", "effect": "ask" },
    { "action": "shell", "resource": "cargo install *", "effect": "ask" },
    { "action": "shell", "resource": "cargo add *", "effect": "ask" },
    { "action": "shell", "resource": "gem install *", "effect": "ask" },
    // lockfile / requirements file: restore, not add. The trailing " *" also
    // matches the bare command and one with a redirect such as `2>&1`.
    { "action": "shell", "resource": "pnpm install --frozen-lockfile *", "effect": "allow" },
    { "action": "shell", "resource": "pnpm i --frozen-lockfile *", "effect": "allow" },
    { "action": "shell", "resource": "bun install --frozen-lockfile *", "effect": "allow" },
    { "action": "shell", "resource": "bun i --frozen-lockfile *", "effect": "allow" },
    { "action": "shell", "resource": "pip* install -r *.txt", "effect": "allow" },
    { "action": "shell", "resource": "python* -m pip install -r *.txt", "effect": "allow" },
    { "action": "shell", "resource": "uv pip install -r *.txt", "effect": "allow" },
    // npx: known packages only. A trailing space or "@" keeps
    // look-alike names (difit-foo) on ask.
    { "action": "shell", "resource": "npx difit *", "effect": "allow" },
    { "action": "shell", "resource": "npx -y difit *", "effect": "allow" },
    { "action": "shell", "resource": "npx --yes difit *", "effect": "allow" },
    { "action": "shell", "resource": "npx --no-install difit *", "effect": "allow" },
    { "action": "shell", "resource": "npx prettier *", "effect": "allow" },
    { "action": "shell", "resource": "npx -y prettier *", "effect": "allow" },
    { "action": "shell", "resource": "npx --yes prettier *", "effect": "allow" },
    { "action": "shell", "resource": "npx jest *", "effect": "allow" },
    { "action": "shell", "resource": "npx -y jest *", "effect": "allow" },
    { "action": "shell", "resource": "npx --yes jest *", "effect": "allow" },
    { "action": "shell", "resource": "npx -y @dataform/cli@*", "effect": "allow" },
    { "action": "shell", "resource": "npx --yes @dataform/cli@*", "effect": "allow" },
    { "action": "shell", "resource": "npx -y @mermaid-js/mermaid-cli@*", "effect": "allow" },
    { "action": "shell", "resource": "npx --yes @mermaid-js/mermaid-cli@*", "effect": "allow" },
    { "action": "shell", "resource": "npx -y -p @mermaid-js/mermaid-cli mmdc *", "effect": "allow" },
    { "action": "shell", "resource": "npx --yes -p @mermaid-js/mermaid-cli mmdc *", "effect": "allow" },
    { "action": "shell", "resource": "npx oxlint *", "effect": "allow" },
    { "action": "shell", "resource": "npx oxfmt *", "effect": "allow" },
    { "action": "shell", "resource": "npx vitest *", "effect": "allow" },
    { "action": "shell", "resource": "npx playwright test *", "effect": "allow" },
    { "action": "shell", "resource": "npx -y markdownlint-cli2 *", "effect": "allow" },
    { "action": "shell", "resource": "npx --yes markdownlint-cli2 *", "effect": "allow" },
    { "action": "shell", "resource": "npx -y pnpm@*", "effect": "allow" },
    { "action": "shell", "resource": "npx --yes pnpm@*", "effect": "allow" },

    // cloud / db: destructive or tokens into the context
    { "action": "shell", "resource": "terraform apply *", "effect": "ask" },
    { "action": "shell", "resource": "terraform destroy *", "effect": "ask" },
    { "action": "shell", "resource": "terraform * apply*", "effect": "ask" },
    { "action": "shell", "resource": "terraform * destroy*", "effect": "ask" },
    { "action": "shell", "resource": "kubectl delete *", "effect": "ask" },
    { "action": "shell", "resource": "kubectl * delete *", "effect": "ask" },
    { "action": "shell", "resource": "gcloud * delete *", "effect": "ask" },
    { "action": "shell", "resource": "gcloud storage rm *", "effect": "ask" },
    { "action": "shell", "resource": "gsutil rm *", "effect": "ask" },
    { "action": "shell", "resource": "gsutil * rm *", "effect": "ask" },
    { "action": "shell", "resource": "bq rm *", "effect": "ask" },
    { "action": "shell", "resource": "bq * rm *", "effect": "ask" },
    { "action": "shell", "resource": "gcloud auth print-access-token*", "effect": "ask" },
    { "action": "shell", "resource": "gcloud auth print-identity-token*", "effect": "ask" },
    { "action": "shell", "resource": "gcloud auth application-default print-access-token*", "effect": "ask" },
    { "action": "shell", "resource": "gcloud spanner databases execute-sql*", "effect": "ask" },
    // projects ending in -dev only; unresolved $P stays on ask. "*" spans
    // spaces, so re-ask on any "-prod" to keep prod out.
    { "action": "shell", "resource": "gcloud spanner databases execute-sql *--project=*-dev *", "effect": "allow" },
    { "action": "shell", "resource": "gcloud spanner databases execute-sql *--project *-dev *", "effect": "allow" },
    { "action": "shell", "resource": "gcloud spanner databases execute-sql *-prod*", "effect": "ask" },
    // psql: local databases only (~80 asks in 5 days, all local test DBs). A
    // host, URL, connection string or service name keeps the ask. Env prefixes
    // like `PGHOST=x psql` are not caught (nor were they before).
    { "action": "shell", "resource": "psql *", "effect": "allow" },
    { "action": "shell", "resource": "psql *-h*", "effect": "ask" },
    { "action": "shell", "resource": "psql *host*", "effect": "ask" },
    { "action": "shell", "resource": "psql *://*", "effect": "ask" },
    { "action": "shell", "resource": "psql *service*", "effect": "ask" },
    { "action": "shell", "resource": "mysql *", "effect": "ask" },
    { "action": "shell", "resource": "mongod *", "effect": "ask" },

    // system
    { "action": "shell", "resource": "dd *", "effect": "ask" },
    { "action": "shell", "resource": "shutdown *", "effect": "ask" },
    { "action": "shell", "resource": "reboot *", "effect": "ask" },
    { "action": "shell", "resource": "halt *", "effect": "ask" },

    // deny: secret files named as a path argument (bare, quoted, `<`,
    // curl `@`). A template next to a secret is indistinguishable here,
    // so .env.example is readable via the read tool, not via bash.
    { "action": "shell", "resource": "* .env *", "effect": "deny" },
    { "action": "shell", "resource": "*/.env *", "effect": "deny" },
    { "action": "shell", "resource": "*\".env\"*", "effect": "deny" },
    { "action": "shell", "resource": "*'.env'*", "effect": "deny" },
    { "action": "shell", "resource": "*/.env\"*", "effect": "deny" },
    { "action": "shell", "resource": "*/.env'*", "effect": "deny" },
    { "action": "shell", "resource": "*<.env *", "effect": "deny" },
    { "action": "shell", "resource": "*@.env *", "effect": "deny" },
    { "action": "shell", "resource": "* .env.*", "effect": "deny" },
    { "action": "shell", "resource": "*/.env.*", "effect": "deny" },
    { "action": "shell", "resource": "*\".env.*", "effect": "deny" },
    { "action": "shell", "resource": "*'.env.*", "effect": "deny" },
    { "action": "shell", "resource": "*<.env.*", "effect": "deny" },
    { "action": "shell", "resource": "*@.env.*", "effect": "deny" },
    // .envrc, also as .envrc.local: only as a path, like .env above, so a
    // command whose text merely names `.envrc`, such as an Issue body, runs.
    { "action": "shell", "resource": "* .envrc*", "effect": "deny" },
    { "action": "shell", "resource": "*/.envrc*", "effect": "deny" },
    { "action": "shell", "resource": "*\".envrc*", "effect": "deny" },
    { "action": "shell", "resource": "*'.envrc*", "effect": "deny" },
    { "action": "shell", "resource": "*<.envrc*", "effect": "deny" },
    { "action": "shell", "resource": "*@.envrc*", "effect": "deny" },
    { "action": "shell", "resource": "*.pem *", "effect": "deny" },
    { "action": "shell", "resource": "*credentials.json*", "effect": "deny" },
    { "action": "shell", "resource": "*.git-credentials*", "effect": "deny" },
    { "action": "shell", "resource": "*credentials.db*", "effect": "deny" },
    { "action": "shell", "resource": "*access_tokens.db*", "effect": "deny" },
    { "action": "shell", "resource": "*/.ssh*", "effect": "deny" },
    { "action": "shell", "resource": "*/.aws*", "effect": "deny" },
    { "action": "shell", "resource": "*id_rsa*", "effect": "deny" },
    { "action": "shell", "resource": "*id_ed25519*", "effect": "deny" },
    // bootstrap .env from a committed template (cp with a non-dir target
    // takes exactly one source)
    { "action": "shell", "resource": "cp *.env.example *.env", "effect": "allow" },
    { "action": "shell", "resource": "cp *.env.sample *.env", "effect": "allow" },
    { "action": "shell", "resource": "cp *.env.template *.env", "effect": "allow" },

    // deny: breaks the machine. Last, so no exception above re-allows it.
    { "action": "shell", "resource": "sudo *", "effect": "deny" },
    { "action": "shell", "resource": "rm * / *", "effect": "deny" },
    { "action": "shell", "resource": "rm * /? *", "effect": "deny" },
    { "action": "shell", "resource": "rm * ~ *", "effect": "deny" },
    { "action": "shell", "resource": "rm * ~/ *", "effect": "deny" },
    { "action": "shell", "resource": "rm * ~/? *", "effect": "deny" },
    { "action": "shell", "resource": "rm * $HOME *", "effect": "deny" },
    { "action": "shell", "resource": "rm * $HOME/ *", "effect": "deny" },
    { "action": "shell", "resource": "rm * $HOME/? *", "effect": "deny" },
    { "action": "shell", "resource": "rm * \"$HOME\" *", "effect": "deny" },
    { "action": "shell", "resource": "rm * \"$HOME/\" *", "effect": "deny" },
    { "action": "shell", "resource": "mkfs*", "effect": "deny" },
    { "action": "shell", "resource": "diskutil erase*", "effect": "deny" },
    { "action": "shell", "resource": "diskutil zeroDisk*", "effect": "deny" },
    { "action": "shell", "resource": "diskutil secureErase*", "effect": "deny" },
    { "action": "shell", "resource": "diskutil partitionDisk*", "effect": "deny" },
    { "action": "shell", "resource": "diskutil apfs delete*", "effect": "deny" },
    { "action": "shell", "resource": "diskutil apfs erase*", "effect": "deny" },
  ],
  // Hard denies for the file tools, which run in the server outside any shell
  // sandbox. Policies here are evaluated after every repository's, so a
  // repository cannot lift them, and they deny edits to this file itself.
  // The resource is "<action>:<path>"; list the absolute "*/" form and the
  // form relative to a home-directory location. They do not cover grep,
  // whose resource is the search pattern, nor shell commands.
  "policies": [
    // OpenCode's service password and provider credentials
    { "action": "tool.use", "resource": "read:*/.config/opencode/service.json", "effect": "deny" },
    { "action": "tool.use", "resource": "read:.config/opencode/service.json", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*/.local/share/opencode/auth.json", "effect": "deny" },
    { "action": "tool.use", "resource": "read:.local/share/opencode/auth.json", "effect": "deny" },
    // global OpenCode and Pi config, their plugins and extensions, where the
    // sandbox lives, and the srt settings
    { "action": "tool.use", "resource": "edit:*/.config/opencode/opencode.json", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*/.config/opencode/opencode.jsonc", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*/.config/opencode/plugin/*", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*/.config/opencode/plugins/*", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*/.pi/agent/settings.json", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*/.pi/agent/extensions/*", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*/.srt-settings.json", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:.config/opencode/opencode.json", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:.config/opencode/opencode.jsonc", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:.config/opencode/plugin/*", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:.config/opencode/plugins/*", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:.pi/agent/settings.json", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:.pi/agent/extensions/*", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:.srt-settings.json", "effect": "deny" },
  ],
  "mcp": {
    "servers": {
      "browse": {
        "type": "local",
        "command": [
          "browse",
          "mcp"
        ],
        "environment": {
          "OPENCODE_BROWSER_RUNTIME": "auto-update"
        }
      }
    }
  },
}
