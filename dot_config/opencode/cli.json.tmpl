{{- /* Keep Herdr's runtime plugin registration and the theme chosen on each machine from the current target. */ -}}
{{- $managed := fromJson `
{
  "$schema": "https://opencode.ai/v2/cli.json"
}
` -}}
{{- $path := joinPath .chezmoi.homeDir ".config/opencode/cli.json" -}}
{{- $config := dict -}}
{{- $original := "" -}}
{{- if stat $path -}}
  {{- $original = include $path -}}
  {{- $config = fromJsonc $original -}}
{{- end -}}
{{- $config = mergeOverwrite $config $managed -}}
{{- if and $original (deepEqual (fromJsonc $original) $config) -}}
{{ $original -}}
{{- else -}}
{{ toPrettyJson $config -}}
{{- end -}}
