#!/usr/bin/env node
// file-replace: apply SEARCH/REPLACE blocks from stdin to several places and
// files in one call.
//
// It stands in for the `python3 - <<'EOF'` scripts that rewrote files with a
// literal string replace. The text is read from stdin and never goes through a
// string literal, so a backslash, a dollar sign or a quote needs no escaping.
// Every block must match exactly one place, and no file is written unless all
// of them do; a failed call leaves every file as it was.
//
// Usage:
//   file-replace <<'EOF'
//   path/to/file
//   <<<<<<< SEARCH
//   text to find
//   =======
//   text to put in its place
//   >>>>>>> REPLACE
//   EOF
//
// A path line names the file for the block that follows it. A block sees the
// result of the blocks before it on the same file. An empty REPLACE deletes
// the matched lines. The first line that is exactly `=======` ends SEARCH, and
// the first line that is exactly `>>>>>>> REPLACE` ends REPLACE.
//
// Exit status: 0 applied, 1 a block did not apply and nothing was written,
// 2 the input or the arguments were malformed.

const fs = require('node:fs')
const path = require('node:path')

const SEARCH = '<<<<<<< SEARCH'
const DIVIDER = '======='
const REPLACE = '>>>>>>> REPLACE'

const USAGE = `Usage: file-replace < blocks

Each block names a file on the line before it:

path/to/file
${SEARCH}
text to find
${DIVIDER}
text to put in its place
${REPLACE}

Every block must match exactly one place. No file is written unless all do.`

function die(code, message) {
  process.stderr.write(`file-replace: ${message}\n`)
  process.exit(code)
}

function parse(input) {
  const lines = input.split('\n')
  if (lines[lines.length - 1] === '') lines.pop()
  const blocks = []
  let pending = []
  let i = 0
  while (i < lines.length) {
    if (lines[i] !== SEARCH) {
      if (lines[i].trim() !== '') pending.push(lines[i].trim())
      i++
      continue
    }
    const n = blocks.length + 1
    if (pending.length !== 1) {
      die(2, `block ${n}: expected one path line before ${SEARCH}, found ${pending.length}`)
    }
    const file = pending[0]
    pending = []
    const search = []
    const replace = []
    i++
    while (i < lines.length && lines[i] !== DIVIDER) search.push(lines[i++])
    if (i === lines.length) die(2, `block ${n} (${file}): no ${DIVIDER} line after ${SEARCH}`)
    i++
    while (i < lines.length && lines[i] !== REPLACE) replace.push(lines[i++])
    if (i === lines.length) die(2, `block ${n} (${file}): no ${REPLACE} line`)
    i++
    if (search.length === 0 || search.join('\n') === '') die(2, `block ${n} (${file}): empty SEARCH`)
    blocks.push({ n, file, search: search.join('\n'), replace, searchLines: search.length })
  }
  if (blocks.length === 0) die(2, 'no block found; see --help')
  if (pending.length > 0) die(2, `text after the last block is not a block: ${pending[0]}`)
  return blocks
}

function countAt(text, needle) {
  let count = 0
  for (let at = text.indexOf(needle); at !== -1; at = text.indexOf(needle, at + 1)) count++
  return count
}

function apply(text, block) {
  const count = countAt(text, block.search)
  if (count === 0) return { error: 'not found' }
  if (count > 1) return { error: `matches ${count} places, expected 1` }
  const at = text.indexOf(block.search)
  let end = at + block.search.length
  let start = at
  const replacement = block.replace.join('\n')
  if (block.replace.length === 0) {
    // Deleting whole lines also deletes the newline that ended the last one.
    const wholeLines = (start === 0 || text[start - 1] === '\n') && (end === text.length || text[end] === '\n')
    if (wholeLines) {
      if (end < text.length) end++
      else if (start > 0) start--
    }
  }
  return { text: text.slice(0, start) + replacement + text.slice(end) }
}

function main() {
  const args = process.argv.slice(2)
  if (args.includes('--help') || args.includes('-h')) {
    process.stdout.write(`${USAGE}\n`)
    return
  }
  if (args.length > 0) die(2, `unknown argument ${args[0]}; see --help`)

  const blocks = parse(fs.readFileSync(0, 'utf8'))
  const contents = new Map()
  for (const block of blocks) {
    const key = path.resolve(block.file)
    if (!contents.has(key)) {
      let text
      try {
        text = fs.readFileSync(key, 'utf8')
      } catch (error) {
        die(1, `block ${block.n} (${block.file}): cannot read the file: ${error.code || error.message}`)
      }
      contents.set(key, text)
    }
    const result = apply(contents.get(key), block)
    if (result.error) die(1, `block ${block.n} (${block.file}): ${result.error}`)
    contents.set(key, result.text)
  }
  for (const [key, text] of contents) fs.writeFileSync(key, text)
  process.stdout.write(`file-replace: ${blocks.length} block(s) applied to ${contents.size} file(s)\n`)
}

main()
