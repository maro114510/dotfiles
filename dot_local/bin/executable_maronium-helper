#!/usr/bin/env node
// maronium-helper: hand agents a GitHub App installation token for one repository.
//
// The App key is read from 1Password by a background process and kept only in
// its memory; this command never writes the key, a JWT, or a token to disk, and
// never passes one as a process argument.
//
// Usage:
//   maronium-helper token <owner>/<repo>   # print an installation token for that repository
//   maronium-helper get                    # git credential helper protocol (github.com only)
//   maronium-helper store|erase            # accepted and ignored, as git expects
//   maronium-helper stop                   # stop the background process
//
// The App and installation to act as live in an uncommitted local file,
// ~/.config/maronium/helper.json: {"appId": ..., "installationId": ..., "keyRef": "op://..."}.
// The process listens on a Unix socket in an owner-only directory,
// ~/.local/state/maronium/, and starts on the first call. Both the config and
// the key are settled for the life of the process, so after editing the config
// or unlocking 1Password, run `maronium-helper stop` and call it again.

const { execFile, spawn } = require('node:child_process')
const crypto = require('node:crypto')
const fs = require('node:fs')
const http = require('node:http')
const https = require('node:https')
const net = require('node:net')
const os = require('node:os')
const path = require('node:path')

const HOME = os.homedir()
const CONFIG_PATH = path.join(HOME, '.config/maronium/helper.json')
const STATE_DIR = path.join(HOME, '.local/state/maronium')
const SOCKET_PATH = path.join(STATE_DIR, 'helper.sock')
const PID_PATH = path.join(STATE_DIR, 'helper.pid')
// The API base is fixed in production. Tests point it at a fake GitHub, since a
// process that may set the environment can already act as the owner.
const API_BASE = process.env.MARONIUM_HELPER_API_BASE || 'https://api.github.com'
// A token is renewed this long before it expires, so a command that outlives its
// token never sends an expired one.
const REFRESH_MARGIN_MS = 10 * 60 * 1000
// What a Bot token may do: push, open pull requests, comment, set commit
// statuses, and read check runs. Never Workflows or Administration.
const BOT_PERMISSIONS = {
  contents: 'write',
  pull_requests: 'write',
  issues: 'write',
  statuses: 'write',
  checks: 'read',
  actions: 'read',
  metadata: 'read',
}
const OP_READ_TIMEOUT_MS = 120 * 1000
const CONNECT_TIMEOUT_MS = 5 * 1000

function fail(message) {
  console.error(`maronium-helper: ${message}`)
  process.exitCode = 1
}

function usage() {
  console.error('usage: maronium-helper token <owner>/<repo> | get | store | erase | stop')
  process.exitCode = 2
}

function readConfig() {
  let raw
  try {
    raw = fs.readFileSync(CONFIG_PATH, 'utf8')
  } catch {
    throw new Error(`no local config at ${CONFIG_PATH}; create it with appId, installationId, and keyRef, then run \`maronium-helper stop\``)
  }
  let config
  try {
    config = JSON.parse(raw)
  } catch {
    throw new Error(`${CONFIG_PATH} is not valid JSON`)
  }
  if (!config.appId || !config.installationId || !config.keyRef) {
    throw new Error(`${CONFIG_PATH} needs appId, installationId, and keyRef`)
  }
  return config
}

function parseRepo(value) {
  const match = /^([A-Za-z0-9_.-]+)\/([A-Za-z0-9_.-]+)$/.exec(value || '')
  if (!match) throw new Error(`not a repository: ${value}`)
  return { owner: match[1], name: match[2] }
}

function readAppKey(keyRef) {
  return new Promise((resolve, reject) => {
    execFile('op', ['read', keyRef], { timeout: OP_READ_TIMEOUT_MS, maxBuffer: 1024 * 1024 }, (error, stdout) => {
      if (error) {
        reject(new Error('the App key could not be read from 1Password; unlock it and run `maronium-helper stop`'))
        return
      }
      resolve(stdout)
    })
  })
}

function createJwt(appId, key) {
  const now = Math.floor(Date.now() / 1000)
  const part = (value) => Buffer.from(JSON.stringify(value)).toString('base64url')
  const unsigned = `${part({ alg: 'RS256', typ: 'JWT' })}.${part({ iat: now - 60, exp: now + 540, iss: appId })}`
  return `${unsigned}.${crypto.createSign('RSA-SHA256').update(unsigned).sign(key, 'base64url')}`
}

function apiRequest(method, pathname, jwt, body) {
  const url = new URL(API_BASE + pathname)
  const client = url.protocol === 'https:' ? https : http
  const payload = body === undefined ? undefined : JSON.stringify(body)
  return new Promise((resolve, reject) => {
    const request = client.request(
      url,
      {
        method,
        headers: {
          authorization: `Bearer ${jwt}`,
          accept: 'application/vnd.github+json',
          'content-type': 'application/json',
          'user-agent': 'maronium-helper',
        },
        timeout: 30 * 1000,
      },
      (response) => {
        let raw = ''
        response.setEncoding('utf8')
        response.on('data', (chunk) => (raw += chunk))
        response.on('end', () => {
          let parsed = null
          try {
            parsed = raw ? JSON.parse(raw) : null
          } catch {
            parsed = null
          }
          resolve({ status: response.statusCode, body: parsed })
        })
      },
    )
    request.on('timeout', () => request.destroy(new Error('GitHub did not answer in time')))
    request.on('error', reject)
    if (payload) request.write(payload)
    request.end()
  })
}

function createAppClient(config, key) {
  const jwt = () => createJwt(config.appId, key)
  return {
    async account() {
      const response = await apiRequest('GET', `/app/installations/${config.installationId}`, jwt())
      if (response.status !== 200 || !response.body?.account?.login) {
        throw new Error(`reading the Bot installation failed: ${response.status}`)
      }
      return response.body.account.login
    },

    async mintToken(name, account) {
      const response = await apiRequest(
        'POST',
        `/app/installations/${config.installationId}/access_tokens`,
        jwt(),
        { repositories: [name], permissions: BOT_PERMISSIONS },
      )
      if (response.status === 422) {
        // 422 also means a permission the App lacks, so ask which one it is:
        // only a repository outside the installation falls back to a refusal.
        const installed = await apiRequest('GET', `/repos/${account}/${name}/installation`, jwt())
        if (installed.status === 404) {
          throw new Error(`refusing ${account}/${name}: the Bot installation does not cover this repository`)
        }
      }
      if (response.status !== 201 || !response.body?.token) {
        throw new Error(`minting a Bot token failed: ${response.status}`)
      }
      return { token: response.body.token, expiresAt: Date.parse(response.body.expires_at) }
    },
  }
}

// The background process: reads the config and the App key, and answers token
// requests. It never logs a token and never writes one to disk.
const cache = new Map()
let setupPromise = null
let accountPromise = null

// Loaded once per process, including a failed read, so the person approves
// 1Password once per boot instead of once per repository.
function loadApp() {
  setupPromise ??= (async () => {
    const config = readConfig()
    const key = await readAppKey(config.keyRef)
    return { config, key }
  })()
  return setupPromise
}

async function mintFor(repo) {
  const { owner, name } = parseRepo(repo)
  const key = `${owner}/${name}`
  const cached = cache.get(key)
  if (cached && Date.now() < cached.expiresAt - REFRESH_MARGIN_MS) return { ok: true, token: cached.token }

  const { config, key: appKey } = await loadApp()
  const client = createAppClient(config, appKey)
  accountPromise ??= client.account()
  const account = await accountPromise
  // GitHub logins are case-insensitive, and a remote may spell the account either way.
  if (owner.toLowerCase() !== account.toLowerCase()) {
    throw new Error(`refusing ${owner}/${name}: the Bot installation belongs to ${account}`)
  }
  const { token, expiresAt } = await client.mintToken(name, account)
  cache.set(key, { token, expiresAt })
  return { ok: true, token }
}

function answer(socket, reply) {
  if (socket.destroyed) return
  socket.end(`${JSON.stringify(reply)}\n`)
}

function serve() {
  fs.mkdirSync(STATE_DIR, { recursive: true, mode: 0o700 })
  fs.chmodSync(STATE_DIR, 0o700)
  // Bind a private name and rename it into place, so a second start never
  // unlinks the socket a running process is serving on.
  const stagingPath = `${SOCKET_PATH}.${process.pid}`
  try {
    fs.unlinkSync(stagingPath)
  } catch {
    // Nothing left over.
  }

  let socketInode = null
  let shuttingDown = false
  const server = net.createServer((socket) => {
    socket.setEncoding('utf8')
    let buffer = ''
    socket.on('error', () => {})
    socket.on('data', (chunk) => {
      buffer += chunk
      const end = buffer.indexOf('\n')
      if (end < 0) return
      let request
      try {
        request = JSON.parse(buffer.slice(0, end))
      } catch {
        answer(socket, { ok: false, error: 'unreadable request' })
        return
      }
      if (request.op === 'stop') {
        answer(socket, { ok: true })
        shutdown()
        return
      }
      if (request.op === 'ping') {
        answer(socket, { ok: true })
        return
      }
      mintFor(request.repo).then(
        (reply) => answer(socket, reply),
        (error) => answer(socket, { ok: false, error: error.message }),
      )
    })
  })

  function shutdown() {
    if (shuttingDown) return
    shuttingDown = true
    server.close()
    try {
      if (socketInode !== null && fs.statSync(SOCKET_PATH).ino === socketInode) fs.unlinkSync(SOCKET_PATH)
    } catch {
      // Already gone, or another process owns the path now.
    }
    try {
      if (fs.readFileSync(PID_PATH, 'utf8') === String(process.pid)) fs.unlinkSync(PID_PATH)
    } catch {
      // Already gone, or another process owns the path now.
    }
    process.exit(0)
  }

  server.on('error', (error) => {
    // Another process may have won the race to serve; it answers this request too.
    process.exit(error.code === 'EADDRINUSE' ? 0 : 1)
  })
  server.listen(stagingPath, () => {
    fs.chmodSync(stagingPath, 0o600)
    fs.renameSync(stagingPath, SOCKET_PATH)
    socketInode = fs.statSync(SOCKET_PATH).ino
    fs.writeFileSync(PID_PATH, String(process.pid), { mode: 0o600 })
  })
  process.on('SIGTERM', shutdown)
  process.on('SIGINT', shutdown)
}

function connect() {
  return new Promise((resolve, reject) => {
    const socket = net.connect(SOCKET_PATH)
    socket.setEncoding('utf8')
    socket.setTimeout(CONNECT_TIMEOUT_MS)
    socket.once('connect', () => {
      socket.setTimeout(0)
      resolve(socket)
    })
    socket.once('timeout', () => socket.destroy(new Error('the helper did not answer')))
    socket.once('error', reject)
  })
}

async function waitForServer(deadline) {
  while (Date.now() < deadline) {
    let socket
    try {
      socket = await connect()
    } catch {
      await new Promise((resolve) => setTimeout(resolve, 50))
      continue
    }
    socket.end()
    return
  }
  throw new Error('the helper process did not start')
}

function startServer() {
  const child = spawn(process.execPath, [process.argv[1], '__serve'], {
    detached: true,
    stdio: 'ignore',
    env: process.env,
  })
  child.unref()
}

function requestToServer(payload) {
  return connect().then(
    (socket) =>
      new Promise((resolve, reject) => {
        let buffer = ''
        socket.on('data', (chunk) => {
          buffer += chunk
          const end = buffer.indexOf('\n')
          if (end >= 0) resolve(JSON.parse(buffer.slice(0, end)))
        })
        socket.on('error', reject)
        // A process that dies mid-request must not leave the caller waiting.
        socket.on('close', () => reject(new Error('the helper closed the connection')))
        socket.write(`${JSON.stringify(payload)}\n`)
      }),
  )
}

async function ask(payload) {
  try {
    return await requestToServer(payload)
  } catch (error) {
    if (error.code !== 'ENOENT' && error.code !== 'ECONNREFUSED') throw error
  }
  startServer()
  await waitForServer(Date.now() + 10 * 1000)
  return requestToServer(payload)
}

async function commandToken(args) {
  if (args.length !== 1) return usage()
  const reply = await ask({ op: 'token', repo: args[0] })
  if (!reply.ok) return fail(reply.error)
  process.stdout.write(`${reply.token}\n`)
}

function readCredentialRequest() {
  const fields = {}
  for (const line of fs.readFileSync(0, 'utf8').split('\n')) {
    const at = line.indexOf('=')
    if (at > 0) fields[line.slice(0, at)] = line.slice(at + 1).trim()
  }
  return fields
}

async function commandGet() {
  const credential = readCredentialRequest()
  // Every other host keeps using whatever credential it already has.
  if (credential.host !== 'github.com') return
  const segments = (credential.path || '').split('/').filter(Boolean)
  if (segments.length < 2) return fail('the credential request names no repository')
  const repo = `${segments[0]}/${segments[1].replace(/\.git$/, '')}`
  const reply = await ask({ op: 'token', repo })
  if (!reply.ok) return fail(reply.error)
  process.stdout.write(`username=x-access-token\npassword=${reply.token}\n`)
}

async function commandStop() {
  // Never start a process only to stop it.
  try {
    await requestToServer({ op: 'stop' })
  } catch {
    // No process was running.
  }
}

async function main() {
  const [command, ...args] = process.argv.slice(2)
  switch (command) {
    case '__serve':
      return serve()
    case 'token':
      return commandToken(args)
    case 'get':
      return commandGet()
    case 'store':
    case 'erase':
      return undefined
    case 'stop':
      return commandStop()
    default:
      return usage()
  }
}

main().catch((error) => fail(error.message))
