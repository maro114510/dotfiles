#!/bin/sh
# Runs the DSH release the repository pins in ~/.config/dsh/package.json, which
# chezmoi applies from dot_config/dsh and Dependabot updates. DSH_VERSION
# overrides the pin. Without either, the wrapper stops instead of guessing.
# A version the supervisor marked as failing is skipped for six hours, in favor
# of the last version that ran.
# The release runs on the node mise resolves, never through a mise shim.
set -eu

state_dir="${XDG_STATE_HOME:-${HOME}/.local/state}/dsh"
pin_file="${XDG_CONFIG_HOME:-${HOME}/.config}/dsh/package.json"
last_good_file="${state_dir}/last-good"
failing_dir="${state_dir}/failing"
failing_ttl_seconds="${DSH_FAILING_TTL_SECONDS:-21600}"
mkdir -p "${state_dir}"

resolved=""
now="$(date +%s)"

read_pin() {
  [ -f "${pin_file}" ] || return 1
  resolved="$(sed -n 's/.*"@deepseek-ai\/dsh"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "${pin_file}" | head -n 1)"
  [ -n "${resolved}" ]
}

resolve() {
  if [ -n "${DSH_VERSION:-}" ]; then
    resolved="${DSH_VERSION}"
    return 0
  fi
  if read_pin; then
    return 0
  fi
  echo "dsh: no pinned release in ${pin_file}; apply dotfiles or set DSH_VERSION" >&2
  return 3
}

resolve
case "${resolved}" in
  '' | *[!A-Za-z0-9._-]*)
    echo "dsh: refusing an invalid release version: ${resolved}" >&2
    exit 3
    ;;
esac

if [ -f "${failing_dir}/${resolved}" ]; then
  marker_epoch="$(cat "${failing_dir}/${resolved}" 2>/dev/null || printf '0')"
  case "${marker_epoch}" in
    '' | *[!0-9]*) marker_epoch=0 ;;
  esac
  if [ $((now - marker_epoch)) -lt "${failing_ttl_seconds}" ] \
    && [ -s "${last_good_file}" ] \
    && [ "$(cat "${last_good_file}")" != "${resolved}" ]; then
    echo "dsh: ${resolved} failed recently; using $(cat "${last_good_file}")" >&2
    resolved="$(cat "${last_good_file}")"
  fi
fi

if [ "${1:-}" = "--resolved-version" ]; then
  printf '%s\n' "${resolved}"
  exit 0
fi

# A mise shim puts every global tool install ahead of the shims on PATH, so a
# server started through one makes each shell it runs ignore the tool versions a
# repository pins. npx starts the dsh bin through `env node`, which is a shim, so
# resolve the bin with npx and run it with the node that mise resolves instead.
node_bin="$(mise which node 2>/dev/null)" || node_bin=""
if [ -n "${node_bin}" ]; then
  dsh_entry="$("${node_bin}" "$(dirname "${node_bin}")/npx" --yes -p "@deepseek-ai/dsh@${resolved}" -c 'command -v dsh')" || dsh_entry=""
  if [ -n "${dsh_entry}" ]; then
    exec "${node_bin}" "${dsh_entry}" "$@"
  fi
fi
exec npx --yes "@deepseek-ai/dsh@${resolved}" "$@"
